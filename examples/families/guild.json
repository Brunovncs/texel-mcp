{
  "$schema": "https://www.texel.dev.br/schema/skinfamily.v1.json",
  "version": 1,
  "kind": "family",
  "name": "Guild uniforms",
  "description": "Three guilds × two ranks from one base. Each guild recolors the uniform and the person, adds its own gear (a headband, a hood, a mantle) and its crest. Captains switch on the cape and rank pips and add pauldrons and a circlet; recruits lose the trim and the crest and carry a satchel.",
  "base": {
    "version": 1,
    "name": "Guild member",
    "model": "classic",
    "palette": {
      "skin": "#c98f63",
      "skinShade": "skin:-8",
      "hair": "#3a2718",
      "hairLight": "hair:+8",
      "eye": "#3b6fb6",
      "primary": "#9b2f2f",
      "primaryLight": "primary:+10",
      "primaryDark": "primary:-12",
      "trim": "#e0a940",
      "trimDark": "trim:-18",
      "belt": "#5b3a1f",
      "pants": "#3b3530",
      "boots": "#2a211c"
    },
    "legend": { "S": "skin", "s": "skinShade", "H": "hair", "h": "hairLight", "W": "#f2f2f2", "E": "eye", "M": "skin:-22" },
    "layers": [
      { "op": "fill", "target": "all", "color": "skin" },
      { "op": "fill", "target": "head.top+back", "color": "hair" },
      { "op": "noise", "target": "head.top+back", "colors": ["hairLight"], "density": 0.25, "seed": 3 },
      {
        "op": "pixels",
        "target": "head.right",
        "rows": ["HHHHHHHH", "HHHHHHHH", "HHHHHHHH", "HHHHHSSS", "HHHHSSSS", "HHHHssSS", "HHHSSSSS", "HHSSSSSS"]
      },
      { "op": "copy", "from": "head.right", "to": "head.left", "flip": "h" },
      {
        "op": "pixels",
        "target": "head.front",
        "id": "face",
        "rows": ["HHHHHHHH", "HhHHHHhH", "HHSSSSHH", "SHHSSHHS", "SWESSEWS", "SSSssSSS", "SSSMMSSS", "SSSSSSSS"]
      },
      { "op": "fill", "target": "head.bottom", "color": "skinShade" },
      { "op": "fill", "target": "body", "color": "primary" },
      { "op": "gradient", "target": "body.sides", "h": 9, "from": "primaryLight", "to": "primaryDark", "steps": 4 },
      { "op": "rect", "target": "body.sides", "y": 9, "h": 1, "color": "belt" },
      { "op": "points", "target": "body.front", "points": [[3, 9], [4, 9]], "color": "trim" },
      { "op": "rect", "target": "body.sides", "y": 10, "color": "pants" },
      { "op": "rect", "target": "rightArm.sides", "h": 4, "color": "primary" },
      { "op": "fill", "target": "rightArm.top", "color": "primary" },
      { "op": "shade", "target": "rightArm.back+left", "amount": -7 },
      { "op": "shade", "target": "rightArm.sides", "y": -1, "amount": -8 },
      { "op": "fill", "target": "rightLeg", "color": "pants" },
      { "op": "noise", "target": "rightLeg.sides", "h": 9, "jitter": 3, "seed": 11 },
      { "op": "rect", "target": "rightLeg.sides", "y": -3, "color": "boots" },
      { "op": "fill", "target": "rightLeg.bottom", "color": "boots:-8" },
      { "op": "shade", "target": "rightLeg.back+left", "amount": -7 },
      { "op": "mirror", "from": "rightArm", "to": "leftArm" },
      { "op": "mirror", "from": "rightLeg", "to": "leftLeg" },
      { "op": "rect", "target": "body.sides", "h": 1, "color": "trim", "id": "trim", "note": "collar trim" },
      { "op": "rect", "target": "arms.sides", "y": 3, "h": 1, "color": "trim", "id": "trim", "note": "sleeve cuffs" },
      { "op": "fill", "target": "body.back@overlay", "color": "primaryDark", "id": "cape", "enabled": false },
      { "op": "rect", "target": "body.back@overlay", "h": 1, "color": "trim", "id": "cape", "enabled": false },
      { "op": "shade", "target": "body.back@overlay", "y": -2, "amount": -8, "id": "cape", "enabled": false },
      { "op": "points", "target": "body.front@overlay", "points": [[6, 2], [6, 4]], "color": "trim", "id": "insignia", "enabled": false, "note": "rank pips" }
    ]
  },
  "matrix": {
    "guild": {
      "ember": {
        "name": "Ember",
        "palette": { "primary": "#9b2f2f", "trim": "#e0a940", "hair": "#6b2a17", "eye": "#b5762a" },
        "layers": [
          { "op": "rect", "target": "head.sides@overlay", "y": 2, "h": 1, "color": "primary", "id": "gear", "note": "headband" },
          { "op": "points", "target": "head.back@overlay", "points": [[3, 3], [4, 3], [3, 4], [4, 5]], "color": "primaryDark", "id": "gear", "note": "headband knot" },
          { "op": "pixels", "target": "body.front@overlay", "x": 1, "y": 2, "id": "emblem", "note": "flame crest", "legend": { "F": "#e8742a", "Y": "#ffcf5a" }, "rows": ["..F.", ".FF.", "FYYF", ".YY."] }
        ]
      },
      "tide": {
        "name": "Tide",
        "palette": { "primary": "#2c5d9b", "trim": "#d5dde8", "skin": "#8d5a3b", "hair": "#1d1a18", "eye": "#3f2a1c" },
        "layers": [
          { "op": "fill", "target": "head.top+back+right+left@overlay", "color": "primaryDark", "id": "gear", "note": "hood" },
          { "op": "pixels", "target": "head.front@overlay", "id": "gear", "note": "hood rim", "legend": { "D": "primaryDark", "d": "primary" }, "rows": ["DDDDDDDD", "Dd....dD", "D......D", "D......D"] },
          { "op": "rect", "target": "head.right+left@overlay", "y": -2, "color": "primary", "id": "gear" },
          { "op": "noise", "target": "head.top+back@overlay", "jitter": 3, "seed": 21, "id": "gear" },
          { "op": "pixels", "target": "body.front@overlay", "x": 1, "y": 2, "id": "emblem", "note": "wave crest", "legend": { "W": "trim", "w": "primaryLight" }, "rows": [".WW.", "W..W", "..WW", "www."] }
        ]
      },
      "grove": {
        "name": "Grove",
        "palette": { "primary": "#3d7a3a", "trim": "#cdb070", "skin": "#efc29a", "hair": "#c4954a", "eye": "#4e8a3c", "mantle": "#6a5532" },
        "layers": [
          { "op": "fill", "target": "body.top@overlay", "color": "mantle", "id": "gear", "note": "mantle" },
          { "op": "rect", "target": "body.sides@overlay", "h": 2, "color": "mantle", "id": "gear", "note": "mantle" },
          { "op": "rect", "target": "body.sides@overlay", "y": 1, "h": 1, "color": "mantle:-8", "id": "gear" },
          { "op": "pixels", "target": "body.front@overlay", "x": 1, "y": 2, "id": "emblem", "note": "leaf crest", "legend": { "L": "#9fd16a", "l": "trim" }, "rows": ["..LL", ".LLL", "LLL.", "l..."] }
        ]
      }
    },
    "rank": {
      "recruit": {
        "name": "Recruit",
        "disable": ["trim", "emblem"],
        "layers": [
          { "op": "line", "target": "body.front@overlay", "from": [1, 0], "to": [6, 8], "color": "belt", "id": "satchel", "note": "strap" },
          { "op": "line", "target": "body.back@overlay", "from": [6, 0], "to": [1, 8], "color": "belt", "id": "satchel" },
          { "op": "rect", "target": "body.front@overlay", "x": 5, "y": 8, "w": 3, "h": 2, "color": "belt:+8", "id": "satchel", "note": "pouch" }
        ]
      },
      "captain": {
        "name": "Captain",
        "enable": ["cape", "insignia"],
        "layers": [
          { "op": "fill", "target": "arms.top@overlay", "color": "trim", "id": "pauldrons" },
          { "op": "rect", "target": "arms.sides@overlay", "h": 2, "color": "trim", "id": "pauldrons" },
          { "op": "rect", "target": "arms.sides@overlay", "y": 2, "h": 1, "color": "trimDark", "id": "pauldrons" },
          { "op": "rect", "target": "head.sides@overlay", "y": 1, "h": 1, "color": "trim", "id": "circlet" },
          { "op": "points", "target": "head.front@overlay", "points": [[3, 1], [4, 1]], "color": "primaryLight", "id": "circlet", "note": "gem" }
        ]
      }
    }
  }
}
