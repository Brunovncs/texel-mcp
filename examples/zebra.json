{
  "$schema": "https://www.texel.dev.br/schema/skinspec.v1.json",
  "version": 1,
  "name": "Zebra",
  "description": "A zebra for the horse model: bold black stripes over white, a dark muzzle, a short upright mane.",
  "layout": "horse",
  "palette": {
    "white": "#ecebe4",
    "black": "#24221f",
    "muzzle": "#3a3633",
    "hoof": "#4a4440",
    "eye": "#141210"
  },
  "layers": [
    { "op": "fill", "target": "all", "color": "white" },
    { "op": "noise", "target": "all", "jitter": 3, "seed": 2 },
    {
      "op": "pattern",
      "id": "stripes",
      "target": "body.right+left+top",
      "kind": "stripes-v",
      "colors": ["black", ".", "."],
      "size": 2,
      "note": "vertical stripes along the flanks and across the back"
    },
    {
      "op": "pattern",
      "target": "body.front+back",
      "kind": "stripes-h",
      "colors": ["black", ".", "."],
      "size": 2
    },
    {
      "op": "pattern",
      "target": "neck.right+left+back",
      "kind": "stripes-h",
      "colors": ["black", "."],
      "size": 2
    },
    {
      "op": "pattern",
      "target": "head.right+left+top+front",
      "kind": "stripes-h",
      "colors": [".", "black"],
      "size": 1
    },
    {
      "op": "pattern",
      "target": "leg.sides",
      "kind": "stripes-h",
      "colors": ["black", "."],
      "size": 1,
      "y": 0,
      "h": 8
    },
    {
      "op": "pattern",
      "target": "tail.sides",
      "kind": "stripes-h",
      "colors": ["black", "."],
      "size": 2,
      "h": 6
    },
    { "op": "rect", "target": "tail.sides", "y": -8, "color": "black" },
    { "op": "fill", "target": "mane", "color": "black" },
    { "op": "rect", "target": "mane.sides", "w": 1, "color": "white" },
    { "op": "fill", "target": "muzzle", "color": "muzzle" },
    { "op": "rect", "target": "muzzle.top", "y": 0, "h": 2, "color": "black" },
    { "op": "rect", "target": "leg.sides+bottom", "y": -2, "color": "hoof" },
    { "op": "fill", "target": "ear", "color": "black" },
    { "op": "points", "target": "head.right+left", "points": [[2, 1], [3, 1]], "color": "eye" },
    { "op": "lighting", "strength": 0.8 }
  ]
}
