{
  "$schema": "https://www.texel.dev.br/schema/skinspec.v1.json",
  "version": 1,
  "name": "Explorer",
  "description": "Brown-haired adventurer with a teal shirt, jeans, boots and a satchel strap.",
  "author": "texel",
  "tags": ["classic", "starter", "human"],
  "model": "classic",
  "palette": {
    "skin": "#d9a066",
    "skinShade": "skin:-8",
    "hair": "#5a3a1e",
    "hairLight": "hair:+8",
    "hairDark": "hair:-9",
    "eyeWhite": "#f4f4f4",
    "eye": "#2d5ba8",
    "mouth": "#9a5a3f",
    "shirt": "#2f8f83",
    "shirtDark": "shirt:-10",
    "belt": "#5b3a1f",
    "buckle": "#e3b341",
    "pants": "#34457a",
    "boots": "#4a3526",
    "strap": "#7a4e2a"
  },
  "legend": {
    "S": "skin",
    "s": "skinShade",
    "H": "hair",
    "h": "hairLight",
    "D": "hairDark",
    "W": "eyeWhite",
    "E": "eye",
    "M": "mouth",
    "T": "shirt"
  },
  "layers": [
    { "op": "fill", "target": "all", "color": "skin", "note": "every base pixel opaque first" },
    { "op": "fill", "target": "head.top+back", "color": "hair" },
    { "op": "noise", "target": "head.top+back", "colors": ["hairLight", "hairDark"], "density": 0.3, "seed": 7 },
    {
      "op": "pixels",
      "target": "head.right",
      "note": "x=0 is the back edge, x=7 touches the face",
      "rows": [
        "HHHHHHHH",
        "HHHHHHHH",
        "HHHHHHHH",
        "HHHHHSSS",
        "HHHHSSSS",
        "HHHHssSS",
        "HHHSSSSS",
        "HHSSSSSS"
      ]
    },
    { "op": "copy", "from": "head.right", "to": "head.left", "flip": "h" },
    {
      "op": "pixels",
      "target": "head.front",
      "rows": [
        "HHHHHHHH",
        "HhHHHhHH",
        "HSSSSSSH",
        "SDDSSDDS",
        "SWESSEWS",
        "SSSssSSS",
        "SSsMMsSS",
        "SSSSSSSS"
      ]
    },
    { "op": "fill", "target": "head.bottom", "color": "skinShade" },
    { "op": "fill", "target": "body", "color": "shirt" },
    { "op": "pixels", "target": "body.front", "rows": ["TTSSSSTT", "TTTSSTTT"] },
    { "op": "noise", "target": "body.sides", "h": 8, "jitter": 4, "seed": 3 },
    { "op": "rect", "target": "body.sides", "y": 8, "h": 1, "color": "belt" },
    { "op": "points", "target": "body.front", "points": [[3, 8], [4, 8]], "color": "buckle" },
    { "op": "rect", "target": "body.sides", "y": 9, "color": "pants" },
    { "op": "fill", "target": "body.bottom", "color": "pants" },
    { "op": "shade", "target": "body.front+back", "x": 0, "w": 1, "amount": -6 },
    { "op": "shade", "target": "body.front+back", "x": -1, "w": 1, "amount": -6 },
    { "op": "shade", "target": "body.back", "amount": -5 },
    { "op": "rect", "target": "rightArm.sides", "h": 4, "color": "shirt" },
    { "op": "fill", "target": "rightArm.top", "color": "shirt" },
    { "op": "rect", "target": "rightArm.sides", "y": 3, "h": 1, "color": "shirtDark" },
    { "op": "shade", "target": "rightArm.back+left", "amount": -7 },
    { "op": "shade", "target": "rightArm.sides", "y": -1, "amount": -8 },
    { "op": "fill", "target": "rightLeg", "color": "pants" },
    { "op": "noise", "target": "rightLeg.sides", "h": 9, "jitter": 3, "seed": 11 },
    { "op": "rect", "target": "rightLeg.sides", "y": -3, "color": "boots" },
    { "op": "fill", "target": "rightLeg.bottom", "color": "boots:-10" },
    { "op": "shade", "target": "rightLeg.sides", "y": -1, "amount": -8 },
    { "op": "shade", "target": "rightLeg.left+back", "amount": -7 },
    { "op": "mirror", "from": "rightArm", "to": "leftArm" },
    { "op": "mirror", "from": "rightLeg", "to": "leftLeg" },
    { "op": "line", "target": "body.front@overlay", "from": [1, 0], "to": [7, 7], "color": "strap", "note": "satchel strap over the jacket layer" },
    { "op": "line", "target": "body.back@overlay", "from": [6, 0], "to": [0, 7], "color": "strap:-8" }
  ]
}
