{
  "$schema": "/schema/skinspec.v1.json",
  "version": 1,
  "name": "Knight",
  "description": "Plate-armored knight with a visored helmet, red plume and blue tabard with a gold cross.",
  "author": "texel",
  "tags": ["classic", "armor", "medieval"],
  "model": "classic",
  "palette": {
    "steel": "#9aa4b1",
    "steelLight": "steel:+12",
    "steelDark": "steel:-15",
    "steelDeep": "steel:-30",
    "visor": "#15181e",
    "plume": "#c0392b",
    "tabard": "#2350a8",
    "gold": "#e3b341",
    "skin": "#c68a5b",
    "leather": "#6b4526"
  },
  "legend": {
    "S": "skin",
    "B": "#3a2616",
    "W": "#eeeeee",
    "E": "#3b6b3b",
    "G": "gold",
    "T": "tabard",
    "t": "tabard:-10"
  },
  "layers": [
    { "op": "fill", "target": "all", "color": "steel" },
    { "op": "pattern", "target": "body+arms", "kind": "checker", "colors": ["steel", "steelDark"], "note": "chainmail" },
    { "op": "fill", "target": "head", "color": "skin" },
    { "op": "pixels", "target": "head.front", "y": 3, "rows": ["SBBSSBBS", "SWESSEWS"] },
    { "op": "fill", "target": "head@overlay", "color": "steel", "note": "helmet on the hat layer" },
    { "op": "gradient", "target": "head.sides@overlay", "from": "steelLight", "to": "steelDark", "steps": 4 },
    { "op": "noise", "target": "head@overlay", "jitter": 3, "seed": 5 },
    { "op": "clear", "target": "head.front@overlay", "x": 1, "y": 3, "w": 6, "h": 2, "note": "visor slit shows the eyes beneath" },
    { "op": "points", "target": "head.front@overlay", "points": [[2, 6], [3, 6], [4, 6], [5, 6]], "color": "visor" },
    { "op": "rect", "target": "head.front@overlay", "x": 3, "y": 0, "w": 2, "h": 3, "color": "steelLight" },
    { "op": "rect", "target": "head.top@overlay", "x": 3, "w": 2, "color": "plume" },
    { "op": "rect", "target": "head.back@overlay", "x": 3, "w": 2, "h": 3, "color": "plume:-10" },
    { "op": "rect", "target": "body.front+back", "x": 2, "w": 4, "h": 9, "color": "tabard" },
    { "op": "pixels", "target": "body.front", "x": 2, "y": 2, "rows": [".GG.", "GGGG", ".GG.", ".GG."] },
    { "op": "shade", "target": "body.front+back", "x": 2, "y": 8, "w": 4, "h": 1, "amount": -10 },
    { "op": "rect", "target": "body.sides", "y": 9, "h": 1, "color": "leather" },
    { "op": "points", "target": "body.front", "points": [[3, 9], [4, 9]], "color": "gold" },
    { "op": "rect", "target": "body.sides", "y": 10, "color": "steelDark" },
    { "op": "gradient", "target": "rightArm.sides", "h": 4, "from": "steelLight", "to": "steelDark", "steps": 4 },
    { "op": "fill", "target": "rightArm.top", "color": "steelLight" },
    { "op": "rect", "target": "rightArm.sides", "y": -3, "color": "steelDeep" },
    { "op": "fill", "target": "rightArm.bottom", "color": "steelDeep" },
    { "op": "gradient", "target": "rightLeg.sides", "from": "steelLight", "to": "steelDark", "steps": 5 },
    { "op": "rect", "target": "rightLeg.front", "y": 5, "h": 1, "color": "steelLight:+8", "note": "knee plate" },
    { "op": "rect", "target": "rightLeg.sides", "y": -2, "color": "steelDeep" },
    { "op": "fill", "target": "rightLeg.bottom", "color": "steelDeep:-8" },
    { "op": "shade", "target": "rightArm.back+left", "amount": -8 },
    { "op": "shade", "target": "rightLeg.back+left", "amount": -8 },
    { "op": "mirror", "from": "rightArm", "to": "leftArm" },
    { "op": "mirror", "from": "rightLeg", "to": "leftLeg" },
    { "op": "gradient", "target": "arms.sides@overlay", "h": 3, "from": "steelLight:+6", "to": "steelDark", "steps": 3, "note": "pauldrons" },
    { "op": "fill", "target": "arms.top@overlay", "color": "steelLight:+6" }
  ]
}
