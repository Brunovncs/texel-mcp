{
  "$schema": "https://www.texel.dev.br/schema/skinspec.v1.json",
  "version": 1,
  "name": "Astronaut",
  "description": "Slim-armed astronaut in a white EVA suit with orange accents, a reflective visor and a life-support pack.",
  "author": "texel",
  "tags": ["slim", "space", "sci-fi"],
  "model": "slim",
  "palette": {
    "suit": "#eceff4",
    "suitShade": "suit:-10",
    "suitDeep": "suit:-24",
    "accent": "#ff7a1a",
    "visor": "#1b2a4a",
    "visorMid": "visor:+12",
    "shine": "#9cc4ff",
    "skin": "#8d5a3b",
    "hair": "#1b1b1b",
    "pack": "#b9c0cc",
    "patch": "#2e6bd6",
    "glove": "#8a93a3"
  },
  "legend": {
    "S": "skin",
    "H": "hair",
    "W": "#f5f5f5",
    "E": "#2b1a10",
    "V": "visor",
    "v": "visorMid",
    "L": "shine",
    "U": "suit",
    "u": "suitShade",
    "A": "accent"
  },
  "layers": [
    { "op": "fill", "target": "all", "color": "suit" },
    { "op": "fill", "target": "head", "color": "skin" },
    { "op": "rect", "target": "head.front+sides", "h": 2, "color": "hair" },
    { "op": "pixels", "target": "head.front", "y": 4, "rows": ["SWESSEWS"] },
    { "op": "fill", "target": "head@overlay", "color": "suit", "note": "helmet shell on the hat layer" },
    {
      "op": "pixels",
      "target": "head.front@overlay",
      "rows": [
        "UUUUUUUU",
        "UuuuuuuU",
        "uVVVVLLu",
        "uVvVVVLu",
        "uVvvVVVu",
        "uVVVVVVu",
        "UuVVVVuU",
        "UUuuuuUU"
      ]
    },
    { "op": "rect", "target": "head.left+right@overlay", "x": 2, "y": 3, "w": 4, "h": 3, "color": "suitShade" },
    { "op": "points", "target": "head.left+right@overlay", "points": [[3, 4], [4, 4]], "color": "accent" },
    { "op": "shade", "target": "head.sides@overlay", "y": -2, "amount": -6 },
    { "op": "rect", "target": "body.sides", "y": 1, "h": 1, "color": "accent" },
    { "op": "rect", "target": "body.front", "x": 2, "y": 3, "w": 4, "h": 3, "color": "suitShade" },
    { "op": "points", "target": "body.front", "points": [[3, 4], [4, 4]], "color": "patch" },
    { "op": "points", "target": "body.front", "points": [[2, 3], [5, 5]], "color": "accent" },
    { "op": "rect", "target": "body.sides", "y": 9, "h": 1, "color": "suitDeep" },
    { "op": "noise", "target": "body.sides", "jitter": 2, "seed": 9 },
    { "op": "rect", "target": "rightArm.front+right", "y": 1, "h": 2, "color": "patch", "note": "mission patch" },
    { "op": "rect", "target": "rightArm.sides", "y": 8, "h": 1, "color": "accent" },
    { "op": "rect", "target": "rightArm.sides", "y": -3, "color": "glove" },
    { "op": "fill", "target": "rightArm.bottom", "color": "glove:-10" },
    { "op": "rect", "target": "rightLeg.sides", "y": 4, "h": 2, "color": "suitShade", "note": "knee pads" },
    { "op": "rect", "target": "rightLeg.sides", "y": 8, "h": 1, "color": "accent" },
    { "op": "rect", "target": "rightLeg.sides", "y": -3, "color": "suitDeep" },
    { "op": "fill", "target": "rightLeg.bottom", "color": "suitDeep:-12" },
    { "op": "shade", "target": "rightArm.back+left", "amount": -7 },
    { "op": "shade", "target": "rightLeg.back+left", "amount": -7 },
    { "op": "shade", "target": "body.back", "amount": -5 },
    { "op": "mirror", "from": "rightArm", "to": "leftArm" },
    { "op": "mirror", "from": "rightLeg", "to": "leftLeg" },
    { "op": "rect", "target": "leftArm.front+left", "y": 1, "h": 2, "color": "suit", "note": "patch only on the right arm" },
    { "op": "rect", "target": "body.back@overlay", "x": 1, "y": 1, "w": 6, "h": 9, "color": "pack", "note": "life-support pack" },
    { "op": "pattern", "target": "body.back@overlay", "x": 2, "y": 2, "w": 4, "h": 3, "kind": "stripes-h", "colors": ["pack:-18", "pack"] },
    { "op": "points", "target": "body.back@overlay", "points": [[2, 7], [5, 7]], "color": "accent" },
    { "op": "shade", "target": "body.back@overlay", "x": 1, "y": 9, "w": 6, "h": 1, "amount": -12 }
  ]
}
